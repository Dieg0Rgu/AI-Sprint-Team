# ==========================================================
# OmniStudio AI · Variables de entorno del Frontend (Vite)
# Copia este archivo como ".env" y ajusta los valores.
# Solo las variables con prefijo VITE_ se exponen al cliente.
# ==========================================================

# ----------------------------------------------------------
# n8n Webhooks (instancia Cloud: devaidiego.app.n8n.cloud)
# Producción  -> prefijo /webhook/
# Desarrollo  -> prefijo /webhook-test/  (requiere pulsar
#                "Test workflow" en el canvas de n8n)
# ----------------------------------------------------------
VITE_N8N_GENERATE_URL=https://devaidiego.app.n8n.cloud/webhook/39fb0e03-e85d-4fc2-8fd4-1b2bf00d18b2
VITE_N8N_CONTACT_URL=https://devaidiego.app.n8n.cloud/webhook/contactrequest
VITE_N8N_SCHEDULE_URL=https://devaidiego.app.n8n.cloud/webhook/schedule-approved

# ----------------------------------------------------------
# Supabase (Dashboard > Project Settings > API)
# ----------------------------------------------------------
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# ----------------------------------------------------------
# OpenAI
# IMPORTANTE: esta clave NUNCA debe vivir en el frontend.
# Configúrala como credencial "OpenAI account" dentro de n8n.
# Se deja aquí solo como referencia para despliegues self-hosted.
# ----------------------------------------------------------
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
