{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contact-request",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "name": "Webhook Contacto",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: 'Notificaciones despachadas con éxito.' }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Access-Control-Allow-Headers",
                "value": "Content-Type, Accept"
              },
              {
                "name": "Access-Control-Allow-Methods",
                "value": "POST, OPTIONS"
              }
            ]
          }
        }
      },
      "name": "Responder Frontend",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 120]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "webhookUri": "https://discord.com/api/webhooks/TU_WEBHOOK_DE_DISCORD",
        "text": "=🚨 **Nueva Solicitud OmniStudio**\n\n👤 **Operador:** {{ $json.body.name }}\n✉️ **Correo:** {{ $json.body.email }}\n📡 **Canal/API:** {{ $json.body.channelType }}\n💬 **Mensaje:**\n> {{ $json.body.message }}"
      },
      "name": "Alerta Discord",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [560, 280]
    },
    {
      "parameters": {
        "chatId": "TU_CHAT_ID_TELEGRAM",
        "text": "=🔔 *Nueva Solicitud OmniStudio*\n\n👤 *Nombre:* {{ $json.body.name }}\n✉️ *Email:* {{ $json.body.email }}\n📡 *Canal:* {{ $json.body.channelType }}\n\n💬 *Mensaje:*\n_{{ $json.body.message }}_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Alerta Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [560, 440]
    },
    {
      "parameters": {
        "fromEmail": "notificaciones@tu-dominio.com",
        "toEmail": "tu_correo@gmail.com",
        "subject": "=OmniStudio: Nueva consulta de {{ $json.body.name }}",
        "text": "=Se ha recibido una nueva solicitud desde la central:\n\nNombre: {{ $json.body.name }}\nEmail: {{ $json.body.email }}\nCanal seleccionado: {{ $json.body.channelType }}\n\nMensaje:\n{{ $json.body.message }}"
      },
      "name": "Alerta Correo (SMTP / Gmail)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [560, 600]
    }
  ],
  "connections": {
    "Webhook Contacto": {
      "main": [
        [
          {
            "node": "Responder Frontend",
            "type": "main",
            "index": 0
          },
          {
            "node": "Alerta Discord",
            "type": "main",
            "index": 0
          },
          {
            "node": "Alerta Telegram",
            "type": "main",
            "index": 0
          },
          {
            "node": "Alerta Correo (SMTP / Gmail)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}