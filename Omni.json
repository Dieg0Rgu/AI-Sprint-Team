        "jsCode": "const items = $input.first().json.body?.approvedVariants || [];\n\nif (!items.length) {\n  throw new Error(\"No se recibieron variantes aprobadas.\");\n}\n\nconst now = new Date();\n\nreturn items.map((item, index) => {\n  // Programa cada publicación con 2 horas de diferencia\n  const startTime = new Date(now.getTime() + (index + 1) * 2 * 60 * 60 * 1000);\n  const endTime = new Date(startTime.getTime() + 30 * 60 * 1000); // 30 min duración\n\n  return {\n    json: {\n      id: item.id,\n      title: item.title,\n      content: item.content,\n      format: item.format,\n      tag: item.tag,\n      scheduled_start: startTime.toISOString(),\n      scheduled_end: endTime.toISOString(),\n      status: 'scheduled'\n    }\n  };\n});"
