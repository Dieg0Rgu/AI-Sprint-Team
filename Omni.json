    {
      "parameters": {
        "jsCode": "const inputItem = $input.first().json;\n\n// 1. Obtener el texto en crudo generado por el LLM\nlet raw = inputItem.text || inputItem.response?.text || inputItem.message?.content || inputItem.output || '';\nif (typeof inputItem === 'object' && !raw) {\n  raw = JSON.stringify(inputItem);\n}\n\n// 2. Intentar parsear como JSON normal primero\nlet variantsMap = {};\n\ntry {\n  // Limpiar etiquetas markdown ```json ... ```\n  let clean = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n  const start = clean.indexOf('{');\n  const end = clean.lastIndexOf('}');\n  if (start !== -1 && end !== -1) {\n    clean = clean.substring(start, end + 1);\n  }\n  const parsed = JSON.parse(clean);\n  const arr = parsed.variants || (Array.isArray(parsed) ? parsed : []);\n  arr.forEach(item => {\n    if (item && item.format) {\n      variantsMap[item.format.toLowerCase()] = item;\n    }\n  });\n} catch (e) {\n  // Si falla el JSON.parse, extraemos los bloques mediante Regex\n}\n\n// 3. Formatos objetivo predeterminados\nconst formatConfigs = [\n  { key: 'hilo', format: 'Hilos', defaultTag: 'X / Twitter', defaultDuration: '5 Tweets' },\n  { key: 'art', format: 'Artículos', defaultTag: 'Blog / Medium', defaultDuration: '950 palabras' },\n  { key: 'bol', format: 'Boletines', defaultTag: 'Substack', defaultDuration: 'Lectura 2 min' },\n  { key: 'vid', format: 'Videos', defaultTag: 'YouTube Shorts', defaultDuration: '0:50 min' },\n  { key: 'aud', format: 'Audios', defaultTag: 'Audiograma', defaultDuration: '4:30 min' }\n];\n\n// 4. Extracción por Regex de respaldo si el JSON falló\nconst variants = formatConfigs.map((cfg, index) => {\n  // Buscar si se parseó correctamente\n  const foundKey = Object.keys(variantsMap).find(k => k.includes(cfg.key));\n  if (foundKey && variantsMap[foundKey]) {\n    const v = variantsMap[foundKey];\n    return {\n      id: String(v.id || `${Date.now()}-${index}`),\n      format: cfg.format,\n      title: String(v.title || `Variante ${cfg.format}`),\n      content: String(v.content || ''),\n      isApproved: false,\n      isEditing: false,\n      durationOrLength: String(v.durationOrLength || cfg.defaultDuration),\n      tag: String(v.tag || cfg.defaultTag)\n    };\n  }\n\n  // Extracción Regex del bloque específico dentro del texto crudo\n  // Busca patrones como: \"format\": \"Hilos\", ... \"title\": \"...\", \"content\": \"...\"\n  const blockRegex = new RegExp(`[\"']format[\"']\\\\s*:\\\\s*[\"'][^\"']*${cfg.key}[^\"']*[\"'][\\\\s\\\\S]*?(?=[\"']format[\"']|$)`, 'i');\n  const matchBlock = raw.match(blockRegex);\n  const blockText = matchBlock ? matchBlock[0] : '';\n\n  const titleMatch = blockText.match(/[\"']title[\"']\\s*:\\s*[\"']([^\"']+)[\"']/i);\n  const contentMatch = blockText.match(/[\"']content[\"']\\s*:\\s*[\"']([^\"']+)[\"']/i);\n  const tagMatch = blockText.match(/[\"']tag[\"']\\s*:\\s*[\"']([^\"']+)[\"']/i);\n  const durationMatch = blockText.match(/[\"']durationOrLength[\"']\\s*:\\s*[\"']([^\"']+)[\"']/i);\n\n  return {\n    id: `${Date.now()}-${index}`,\n    format: cfg.format,\n    title: titleMatch ? titleMatch[1] : `Variante para ${cfg.format}`,\n    content: contentMatch ? contentMatch[1].replace(/\\\\n/g, '\\n') : (blockText ? blockText.slice(0, 300) : 'Generando contenido optimizado...'),\n    isApproved: false,\n    isEditing: false,\n    durationOrLength: durationMatch ? durationMatch[1] : cfg.defaultDuration,\n    tag: tagMatch ? tagMatch[1] : cfg.defaultTag\n  };\n});\n\nreturn { variants };"
      },
